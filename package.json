{
  "name": "recruiter-bot",
  "version": "1.0.0",
  "description": "Recruiter Bot: ranks fictional candidates against job openings using raw SQL and SQLite.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/db/database.js",
    "db:reset": "node src/db/database.js --reset",
    "sql:detective": "node scripts/run-sql-detective.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0"
  }
}
